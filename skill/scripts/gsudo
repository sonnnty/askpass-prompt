#!/usr/bin/env bash
# Run a command with sudo, asking for the password in a desktop dialog.
# Usage: gsudo <command> [args...]   (same as sudo, minus the terminal prompt)
set -u
here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

if [ "$#" -eq 0 ]; then
  echo "usage: gsudo <command> [args...]" >&2
  exit 2
fi

# Already authorized (cached timestamp or NOPASSWD): no dialog needed.
if sudo -n true 2>/dev/null; then
  exec sudo "$@"
fi

export SUDO_ASKPASS="$here/askpass"
export ASKPASS_PROMPT_CMD="$*"
exec sudo -A "$@"
